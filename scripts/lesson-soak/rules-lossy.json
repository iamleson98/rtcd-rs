{
  "compare": [
    {
      "subject": "rtcd-rs",
      "baseline": "rtcd-go"
    },
    {
      "subject": "rtcd-rs/chrome",
      "baseline": "rtcd-go/chrome",
      "clean_zero": [
        "stalls",
        "closes",
        "ice_disc"
      ]
    }
  ],
  "require_groups": [
    "clean",
    "impaired"
  ],
  "ratio": 1.25,
  "warmup_min": 15,
  "window_min": 20,
  "min_clean_window_min": 5,
  "rss_slope_mb_per_h_max": 30,
  "rss_slope_min_span_min": 30,
  "clean_zero": [
    "stalls",
    "freezes",
    "closes",
    "ice_disc"
  ],
  "targets": [
    {
      "name": "audio gap at 20 % loss <= 5 % (Meet target)",
      "metric": "audio_gap",
      "max": 5,
      "scope": "impaired",
      "phase": "loss20",
      "gated": false
    },
    {
      "name": "audio concealed at 20 % loss <= 5 % (Meet target, Chrome)",
      "metric": "conceal_pct",
      "max": 5,
      "scope": "impaired",
      "phase": "loss20",
      "gated": false
    },
    {
      "name": "audio delay p95 <= 250 ms (Meet target, clean group)",
      "metric": "delay_audio_p95",
      "max": 250,
      "scope": "clean",
      "gated": false
    }
  ]
}
