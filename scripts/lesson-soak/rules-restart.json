{
  "compare": [
    {
      "subject": "rtcd-rs",
      "baseline": "rtcd-go"
    },
    {
      "subject": "rtcd-rs/chrome",
      "baseline": "rtcd-go/chrome",
      "clean_zero": [
        "stalls",
        "closes",
        "ice_disc"
      ]
    }
  ],
  "require_groups": [
    "clean",
    "impaired"
  ],
  "ratio": 1.25,
  "warmup_min": 15,
  "window_min": 20,
  "min_clean_window_min": 5,
  "rss_slope_mb_per_h_max": 30,
  "rss_slope_min_span_min": 30,
  "clean_zero": [
    "stalls",
    "freezes",
    "closes",
    "ice_disc"
  ],
  "recover_window_s": 150,
  "targets": [
    {
      "name": "SFU restart: every track receives again within 30 s (Meet target) (impaired group)",
      "metric": "restart_recover_max",
      "max": 30,
      "gated": false,
      "scope": "impaired"
    },
    {
      "name": "SFU restart: every track receives again within 180 s (impaired group)",
      "metric": "restart_recover_max",
      "max": 180,
      "scope": "impaired"
    },
    {
      "name": "SFU restart: every track receives again within 30 s (Meet target) (clean group)",
      "metric": "restart_recover_max",
      "max": 30,
      "gated": false,
      "scope": "clean"
    },
    {
      "name": "SFU restart: every track receives again within 180 s (clean group)",
      "metric": "restart_recover_max",
      "max": 180,
      "scope": "clean"
    },
    {
      "name": "audio delay p95 <= 250 ms (Meet target, clean group)",
      "metric": "delay_audio_p95",
      "max": 250,
      "scope": "clean",
      "gated": false
    }
  ]
}
